# A hash establishes input identity, not source-to-binary provenance or release approval.
if(NOT DEFINED SYBL_JAMI_CORE_LIBRARY OR
   NOT EXISTS "${SYBL_JAMI_CORE_LIBRARY}" OR
   IS_DIRECTORY "${SYBL_JAMI_CORE_LIBRARY}")
  message(FATAL_ERROR "Missing Windows daemon archive: ${SYBL_JAMI_CORE_LIBRARY}. See docs/OPERATIONS.md.")
endif()
string(LENGTH "${SYBL_JAMI_CORE_SHA256}" _expected_length)
if(NOT _expected_length EQUAL 64 OR NOT SYBL_JAMI_CORE_SHA256 MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "SYBL_JAMI_CORE_SHA256 must be the recorded 64-digit input hash.")
endif()
file(SHA256 "${SYBL_JAMI_CORE_LIBRARY}" _actual_hash)
string(TOLOWER "${SYBL_JAMI_CORE_SHA256}" _expected_hash)
if(NOT _actual_hash STREQUAL _expected_hash)
  message(FATAL_ERROR "Windows daemon archive hash mismatch: ${SYBL_JAMI_CORE_LIBRARY}\nExpected: ${_expected_hash}\nActual: ${_actual_hash}")
endif()
message(STATUS "Windows daemon archive: ${SYBL_JAMI_CORE_LIBRARY} SHA-256=${_actual_hash}")
foreach(_input IN ITEMS SSL CRYPTO)
  set(_path "${SYBL_OPENSSL_${_input}_DLL}")
  set(_hash "${SYBL_OPENSSL_${_input}_SHA256}")
  if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}")
    message(FATAL_ERROR "Missing Windows OpenSSL ${_input} DLL: ${_path}")
  endif()
  string(LENGTH "${_hash}" _hash_length)
  if(NOT _hash_length EQUAL 64 OR NOT _hash MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "SYBL_OPENSSL_${_input}_SHA256 must be a recorded 64-digit input hash.")
  endif()
  file(SHA256 "${_path}" _actual_dll_hash)
  string(TOLOWER "${_hash}" _expected_dll_hash)
  if(NOT _actual_dll_hash STREQUAL _expected_dll_hash)
    message(FATAL_ERROR "Windows OpenSSL ${_input} DLL hash mismatch: ${_path}")
  endif()
  if(DEFINED SYBL_VERIFY_RUNTIME_DIR)
    get_filename_component(_name "${_path}" NAME)
    set(_copy "${SYBL_VERIFY_RUNTIME_DIR}/${_name}")
    if(NOT EXISTS "${_copy}" OR IS_DIRECTORY "${_copy}")
      message(FATAL_ERROR "Missing packaged Windows OpenSSL ${_input} DLL: ${_copy}")
    endif()
    file(SHA256 "${_copy}" _actual_copy_hash)
    if(NOT _actual_copy_hash STREQUAL _expected_dll_hash)
      message(FATAL_ERROR "Packaged Windows OpenSSL ${_input} DLL hash mismatch: ${_copy}")
    endif()
  endif()
  message(STATUS "Windows OpenSSL ${_input} DLL: ${_path} SHA-256=${_actual_dll_hash}")
endforeach()
