<Page
    x:Class="WidgetSampleCS.ClockWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid x:Name="Viewport"><Viewbox Stretch="Uniform">
    <Border x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10" Padding="0">
        <StackPanel x:Name="ClockRows" Spacing="8" MinWidth="1" MinHeight="1" />
    </Border>
    </Viewbox></Grid>
</Page>
