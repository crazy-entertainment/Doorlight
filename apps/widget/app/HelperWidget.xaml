<Page
    x:Class="WidgetSampleCS.HelperWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WidgetBackground}" Foreground="{ThemeResource WidgetInk}"
    FontFamily="ms-appx:///Assets/Fonts/HankenGrotesk-Variable.ttf#Hanken Grotesk" FontSize="14"
    RequestedTheme="Dark">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="HeaderWash" Grid.RowSpan="5" IsHitTestVisible="False" Background="{ThemeResource WidgetBackground}" />
        <Grid x:Name="Tabs" Margin="16,16,16,0" ColumnSpacing="4" />
        <Border x:Name="DesktopSetupNotice" Grid.Row="1" Visibility="Collapsed" Margin="20,12,20,0" Padding="12" CornerRadius="8" Background="{ThemeResource WidgetSurface}" BorderBrush="{ThemeResource WidgetBorder}" BorderThickness="1">
            <StackPanel Spacing="6">
                <TextBlock x:Name="DesktopSetupTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DesktopSetupText" Foreground="{ThemeResource WidgetMuted}" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DesktopSetupAction" Click="DesktopSetupAction_Click" />
                    <Button Content="Check again" Click="DesktopSetupRefresh_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid x:Name="PageHeader" Grid.Row="2" Margin="20,12,20,12" ColumnSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Title" FontFamily="ms-appx:///Assets/Fonts/HankenGrotesk-Variable.ttf#Hanken Grotesk" FontSize="34" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel x:Name="VisibilityControls" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="VisibilityLabel" Text="Hidden" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource WidgetMuted}" />
                <ToggleSwitch x:Name="VisibleSwitch" OnContent="" OffContent="" MinWidth="0" Width="44" Padding="0" Toggled="VisibleSwitch_Toggled" AutomationProperties.Name="Show selected widget" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Body" Spacing="8" Margin="20,0,20,8" />
        </ScrollViewer>
        <Border x:Name="Footer" Grid.Row="4" Background="{ThemeResource WidgetBackground}" BorderThickness="0" Padding="20,0,20,2">
            <StackPanel Spacing="0">
                <TextBlock x:Name="Status" FontSize="13" Foreground="{ThemeResource WidgetInk}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RetrySettings" Content="Retry settings" Visibility="Collapsed" Click="RetrySettings_Click" />
                <TextBlock x:Name="Versions" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource WidgetMuted}" />
            </StackPanel>
        </Border>
        <Canvas x:Name="VibeCanvas" Grid.RowSpan="5" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</Page>
